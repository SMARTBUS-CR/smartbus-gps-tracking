APP_NAME="SmartBus GPS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos de OPERACIONES compartida (PostgreSQL + PostGIS).
# Ya existe; administrada por otro integrante. Este servicio NO corre migraciones.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=smartbus_operations
DB_USERNAME=
DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# --- Laravel Reverb (WebSockets, HU2/HU3) ---
# Generar credenciales unicas por entorno:  php artisan reverb:install  (o a mano)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

# --- API Gateway: cabeceras de identidad reenviadas (defaults = lo que ya envia el Gateway) ---
# GATEWAY_HEADER_USER_ID=X-User-Id
# GATEWAY_HEADER_ROLES=X-User-Roles

# --- Volumen de GPS: transmitir != persistir (ver config/gps.php) ---
# Filtro de guardado (HU1) - no afecta la transmision en vivo (HU2/broadcast):
# GPS_PERSIST_MIN_DISTANCE_METERS=15
# GPS_PERSIST_MIN_INTERVAL_SECONDS=60
# Retencion (housekeeping, PruneGpsLocations):
# GPS_LOCATIONS_RETENTION_DAYS=60
# GPS_LOCATIONS_PRUNE_CHUNK=5000

# --- Integraciones externas (FUTURO - ver docs/INTEGRATIONS.md) ---
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
ORS_PROFILE=driving-hgv
ORS_TIMEOUT=5
OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
OSM_ATTRIBUTION="(c) OpenStreetMap contributors"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
